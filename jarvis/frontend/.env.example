# Connect to your own agent with one of the following. Leave both blank to connect to the
# LiveKit homepage agent.

# Development token server ID from your project's Settings page in LiveKit Cloud.
# https://docs.livekit.io/frontends/build/authentication/development-token-server/
LIVEKIT_TOKEN_SERVER_ID=

# Otherwise use LiveKit credentials for the included token endpoint (app/api/token/route.ts).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Required by the private token endpoint. Configure this as a server-only
# environment variable in Vercel; do not use a NEXT_PUBLIC_ prefix. Use a long
# random value (32+ characters).
JARVIS_ACCESS_CODE=

# Token lifetime for the token endpoint. Accepts e.g. 30s, 15m or 1h; anything
# outside 1 minute to 6 hours falls back to 15m.
LIVEKIT_TOKEN_TTL=15m

# Failed access-code attempts allowed per client address, and the window in
# seconds (60-86400). Exceeding the limit returns HTTP 429.
AUTH_RATE_LIMIT_MAX_FAILURES=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Distributed rate limiting. Required in production so every server instance
# shares the same failure counts; without it the endpoint falls back to
# per-instance memory, which a client can bypass on another instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# UNSAFE: disabling access-code authentication is never recommended for a
# normal deployment. Anyone who knows the token endpoint can then mint a room
# token and talk to your agent. Leave unset/false.
ALLOW_PUBLIC_TOKEN=false

# Server-only PostgreSQL connection (see lib/database.ts). Use the pooled
# Supavisor connection string from a Supabase *development* project (port 6543,
# transaction mode) with TLS, or a local database for the schema tests. Never
# prefix this with NEXT_PUBLIC_: that would inline the password into the browser
# bundle. Never point this at production.
DATABASE_URL=

# Optional: full PEM CA certificate for remote PostgreSQL TLS. Use this when
# the runtime does not already trust Supabase Root 2021 (for example on Vercel,
# where SELF_SIGNED_CERT_IN_CHAIN means the CA is missing). Include the
# BEGIN/END CERTIFICATE lines and the real line breaks. Server-only: never use a
# NEXT_PUBLIC_ prefix. Verification stays enabled; TLS is never disabled here.
DATABASE_CA_CERT=

# Direct connection (port 5432) for the Supabase CLI and migrations only.
# Application code never reads it; `pnpm db:verify --development` does, to run
# read-only checks. Do not add this to Vercel. See ../supabase/README.md.
DIRECT_URL=
